# Signal Forge — example environment file.
# Copy to `.env` and fill in. NEVER commit `.env`. Placeholders only in this file.
# All keys are read via pydantic-settings and wrapped in SecretStr; they are
# redacted from logs and never written to the database.

# ----------------------------------------------------------------------------
# Market data
# ----------------------------------------------------------------------------
# Phase 1 default: leave MARKET_DATA_PROVIDER=fixture for a deterministic,
# offline, clearly-labelled SIMULATED dataset. Set to a real adapter name
# (e.g. "stooq", "tiingo", "alpaca_data") once you have an entitlement.
MARKET_DATA_PROVIDER=fixture
MARKET_DATA_API_KEY=

# Optional second source used only for cross-source reconciliation checks.
MARKET_DATA_PROVIDER_SECONDARY=
MARKET_DATA_API_KEY_SECONDARY=

# ----------------------------------------------------------------------------
# News / filings (optional in Phase 1)
# ----------------------------------------------------------------------------
NEWS_PROVIDER=
NEWS_API_KEY=

# ----------------------------------------------------------------------------
# LLM explanation layer (OPTIONAL — system works fully without it).
# Never used to decide entries, exits, sizing, or ranking.
# ----------------------------------------------------------------------------
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5

# ----------------------------------------------------------------------------
# Notifications (Phase 1: all OFF until setup completed; local log always on)
# ----------------------------------------------------------------------------
NOTIFICATION_PROVIDER=
NOTIFICATION_API_KEY=
# SMTP (only if NOTIFICATION_PROVIDER=email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# ----------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------
# Phase 1: SQLite (below). Phase 2+: set a postgresql+psycopg:// URL — see README.
DATABASE_URL=sqlite+pysqlite:///./data/signalforge.sqlite

# ----------------------------------------------------------------------------
# App
# ----------------------------------------------------------------------------
# 32+ byte random string. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_ENCRYPTION_KEY=
# Bind to loopback only by default.
APP_HOST=127.0.0.1
APP_PORT=8787
APP_ENV=dev
# Comma-separated. Leave default for local-only use.
APP_ALLOWED_HOSTS=127.0.0.1,localhost
